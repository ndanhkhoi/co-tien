# OpenAI-compatible Images API for .claude/skills/game-art (gen-image.sh --tool api).
# Copy to .env.image-api (gitignored) and fill in. Never commit the real key.

# Base URL up to and including /v1 (the script appends /images/generations or /images/edits).
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_API_KEY=
# Image model name as your provider calls it.
IMAGE_API_MODEL=gpt-image-1
# Optional: low | medium | high | auto (leave empty if the provider rejects it).
IMAGE_API_QUALITY=
# 1 if the provider supports background=transparent (needed for clean character cut-outs).
IMAGE_API_TRANSPARENT=1
# 1 if the model accepts reference images (images[] on /images/generations; keeps a champion's face consistent).
IMAGE_API_EDITS=1

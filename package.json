{
  "name": "co-tien",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Cơ Tiên — bida tu tiên cho mobile & desktop (PWA)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "gen:challenges": "vite-node tools/gen-challenges.ts",
    "lint": "eslint . && stylelint \"src/styles/*.css\" && vite-node tools/check-css.ts && knip && jscpd"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.2",
    "knip": "^6.44.0",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.1",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  }
}

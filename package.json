{
  "name": "than-cong-bida",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "THẦN CÔNG — game bida kỹ năng cho mobile & desktop (PWA)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "gen:challenges": "vite-node tools/gen-challenges.ts",
    "gen:icons": "node tools/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  }
}
